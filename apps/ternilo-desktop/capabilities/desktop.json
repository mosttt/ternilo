{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Expose Ternilo's native desktop adapters only to its loopback UI origins.",
  "local": false,
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  },
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-pick-workspace",
    "allow-desktop-notify",
    "allow-desktop-initial-links"
  ]
}
