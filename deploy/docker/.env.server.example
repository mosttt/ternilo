# Optional Compose settings; SQLite/external PostgreSQL can start without this file.
# Choose the Server database and public URL in web setup; config.json saves them.
# The active values below repeat Compose defaults. Change them only when needed.
TERNILO_IMAGE=ghcr.io/mosttt/ternilo-server:0.2.6
TERNILO_DEPLOY_PROJECT=ternilo-server
TERNILO_SERVER_HTTP_BIND_ADDRESS=127.0.0.1
TERNILO_SERVER_HTTP_PORT=4321
TERNILO_SERVER_MANAGED_EXECUTION_ENABLED=false
# Advanced startup overrides: set these only to override the saved Server configuration.
# Leave these commented when using the database/public URL saved by web setup.
# TERNILO_SERVER_PUBLIC_URL=https://ternilo.example.com
# TERNILO_DATABASE_URL=postgresql://ternilo_app:password@postgres:5432/ternilo
# TERNILO_MIGRATION_DATABASE_URL=postgresql://ternilo_owner:password@postgres:5432/ternilo
# Only for compose.server.postgres.yml: bootstrap the PostgreSQL service before web setup.
# These are database-role passwords, separate from the Ternilo administrator password.
# Set all three before first start; choose the Server connection in the web setup page.
# TERNILO_POSTGRES_ADMIN_PASSWORD=replace-with-a-private-database-admin-password
# TERNILO_POSTGRES_OWNER_PASSWORD=replace-with-a-private-database-owner-password
# TERNILO_POSTGRES_APP_PASSWORD=replace-with-a-private-runtime-password
